#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

cargo fmt --check
cargo clippy --all-targets -- -D warnings
cargo test
cargo build --release

if [[ -f target/release/clew.exe ]]; then
  release_bin=target/release/clew.exe
  promoted_bin=.clew/bin/clew.exe
else
  release_bin=target/release/clew
  promoted_bin=.clew/bin/clew
fi

mkdir -p .clew/bin
cp "$release_bin" "$promoted_bin"
chmod +x "$promoted_bin"

echo "Promoted $release_bin to $promoted_bin" >&2
